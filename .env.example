# Copy this file to .env and fill in the values. Never commit .env.

# Required. Key for any OpenAI-compatible provider (OpenAI, Groq, OpenRouter, ...).
OPENAI_API_KEY=

# Required. Web search key from https://tavily.com (free tier available).
TAVILY_API_KEY=

# Optional. Defaults shown. Change both to use another OpenAI-compatible provider,
# e.g. OPENAI_BASE_URL=https://api.groq.com/openai/v1 and MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Optional. Port for the web UI.
PORT=3000
